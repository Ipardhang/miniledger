PORT=4000
DATABASE_URL=postgres://miniledger:miniledger@localhost:5432/miniledger
JWT_SECRET=replace-with-a-long-random-secret
APP_ORIGINS=http://localhost:8081

# Development/testing only. Do not set in production.
# MOCK_OTP=123456

# Production SMS (Twilio)
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxx
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# Receipt storage: local for development, s3 for production/Vercel.
RECEIPT_STORAGE=local
# S3_ENDPOINT=https://...
# S3_BUCKET=miniledger-receipts
# S3_REGION=auto
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
